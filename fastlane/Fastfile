# Release automation for La Popote.
# Authenticates with an App Store Connect API key stored outside the repo:
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 and ~/.appstoreconnect/issuer_id
# Override with ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH.
default_platform(:ios)

KEY_DIR = File.expand_path("~/.appstoreconnect")

def asc_key_id
  ENV["ASC_KEY_ID"] || Dir[File.join(KEY_DIR, "private_keys", "AuthKey_*.p8")].first.to_s[/AuthKey_(\w+)\.p8/, 1]
end

def asc_key_path
  ENV["ASC_KEY_PATH"] || File.join(KEY_DIR, "private_keys", "AuthKey_#{asc_key_id}.p8")
end

def asc_issuer_id
  ENV["ASC_ISSUER_ID"] || File.read(File.join(KEY_DIR, "issuer_id")).strip
end

def api_key
  app_store_connect_api_key(key_id: asc_key_id, issuer_id: asc_issuer_id, key_filepath: asc_key_path, in_house: false)
end

platform :ios do
  desc "Register the bundle IDs and app group in the developer portal"
  lane :register do
    api_key
    require "spaceship"
    { "net.dauernheim.popote" => "La Popote", "net.dauernheim.popote.widgets" => "La Popote Widgets" }.each do |id, name|
      existing = Spaceship::ConnectAPI::BundleId.find(id)
      bundle = existing || Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: id)
      UI.message("#{id}: #{existing ? 'exists' : 'created'} (#{bundle.id})")
      begin
        bundle.update_capability("APP_GROUPS", enabled: true)
      rescue => e
        UI.important("APP_GROUPS on #{id}: #{e.message}")
      end
    end
  end

  desc "Create/refresh the distribution certificate and App Store provisioning profiles"
  lane :signing do
    api_key
    cert(development: false, generate_apple_certs: true, output_path: "build/certs")
    { "net.dauernheim.popote" => "La Popote AppStore", "net.dauernheim.popote.widgets" => "La Popote Widgets AppStore" }.each do |id, name|
      sigh(app_identifier: id, provisioning_name: name, force: true, output_path: "build/profiles", skip_install: false)
    end
  end

  desc "Create the internal TestFlight group and add the given team members (EMAILS=a@x,b@y; default: you)"
  lane :testers do |options|
    api_key
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("net.dauernheim.popote")
    group = app.get_beta_groups.find { |g| g.name == "Famille" } ||
            app.create_beta_group(group_name: "Famille", is_internal_group: true, has_access_to_all_builds: true, public_link_enabled: nil, public_link_limit: nil, public_link_limit_enabled: nil)
    emails = (options[:emails] || ENV["EMAILS"] || "uwe@dauernheim.net").split(",").map(&:strip)
    users = Spaceship::ConnectAPI::User.all
    emails.each do |email|
      user = users.find { |u| u.username.to_s.casecmp?(email) }
      unless user
        UI.important("#{email} is not an App Store Connect team member yet (pending invitation?); skipped")
        next
      end
      begin
        Spaceship::ConnectAPI.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: user.username, firstName: user.first_name, lastName: user.last_name }
        )
        UI.success("Added #{email} to #{group.name}")
      rescue => e
        UI.message("#{email}: #{e.message.lines.first.to_s.strip}")
      end
    end
  end

  desc "Invite someone to App Store Connect (Marketing role, La Popote only) so they can be an internal tester. EMAIL=… FIRST=… LAST=…"
  lane :invite do |options|
    api_key
    require "spaceship"
    email = options[:email] || ENV["EMAIL"]
    UI.user_error!("Pass email:") unless email
    app = Spaceship::ConnectAPI::App.find("net.dauernheim.popote")
    if Spaceship::ConnectAPI::User.all.any? { |u| u.username.to_s.casecmp?(email) }
      UI.message("#{email} is already a team member")
    else
      Spaceship::ConnectAPI::UserInvitation.create(
        email: email,
        first_name: options[:first] || ENV["FIRST"] || email.split("@").first,
        last_name: options[:last] || ENV["LAST"] || "-",
        roles: ["MARKETING"],
        provisioning_allowed: false,
        all_apps_visible: false,
        visible_app_ids: [app.id]
      )
      UI.success("Invitation sent to #{email}")
    end
  end

  desc "Give an existing team member access to La Popote (needed before adding them as internal tester). EMAIL=…"
  lane :grant_access do |options|
    api_key
    require "spaceship"
    email = options[:email] || ENV["EMAIL"]
    app = Spaceship::ConnectAPI::App.find("net.dauernheim.popote")
    user = Spaceship::ConnectAPI::User.all.find { |u| u.username.to_s.casecmp?(email) }
    UI.user_error!("#{email} is not a team member") unless user
    UI.message("roles=#{user.roles.inspect} all_apps_visible=#{user.all_apps_visible}")
    visible = (user.get_visible_apps rescue []).map(&:bundle_id)
    UI.message("visible apps: #{visible.inspect}")
    if user.all_apps_visible || visible.include?("net.dauernheim.popote")
      UI.message("#{email} already has access")
    else
      Spaceship::ConnectAPI.add_user_visible_apps(user_id: user.id, app_ids: [app.id])
      UI.success("Gave #{email} access to La Popote")
    end
  end

  desc "Revoke a pending App Store Connect invitation. EMAIL=…"
  lane :revoke_invite do |options|
    api_key
    require "spaceship"
    email = options[:email] || ENV["EMAIL"]
    invites = Spaceship::ConnectAPI::UserInvitation.find(email: email)
    UI.user_error!("No pending invitation for #{email}") if invites.empty?
    invites.each(&:delete!)
    UI.success("Revoked invitation for #{email}")
  end

  desc "Build and upload a TestFlight build (internal testers)"
  lane :beta do
    key = api_key
    signing
    sh("cd .. && xcodegen generate --quiet")
    build_number = sh("git rev-list --count HEAD").strip.to_i + 100
    increment_build_number(xcodeproj: "Popote.xcodeproj", build_number: build_number)
    build_app(
      project: "Popote.xcodeproj",
      scheme: "Popote",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/release",
      clean: true,
      export_options: {
        signingStyle: "manual",
        manageAppVersionAndBuildNumber: false,
        provisioningProfiles: {
          "net.dauernheim.popote" => "La Popote AppStore",
          "net.dauernheim.popote.widgets" => "La Popote Widgets AppStore"
        }
      }
    )
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      changelog: "Première version de La Popote pour iOS."
    )
  end
end
